<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wx200_motion_interface</name>
  <version>0.1.0</version>
  <description>Position control action server for wx200 arm via MoveIt 2</description>
  <maintainer email="kylezthompson@gmail.com">KThompson2002</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>interbotix_xsarm_moveit</exec_depend>
  <exec_depend>interbotix_xsarm_ros_control</exec_depend>
  <exec_depend>interbotix_xs_modules</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
